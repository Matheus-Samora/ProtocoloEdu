# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - PROTOCOLOEDU EM PRODUÇÃO
# ==============================================================================

# Porta de escuta da aplicação
PORT=8080

# Chave oficial da API Google Gemini (para OCR multimodal e auditoria técnica)
GEMINI_API_KEY=AIzaSy...sua_chave_aqui...

# Chave secreta de autenticação para as Secretarias Acadêmicas (Header X-Admin-Key)
ADMIN_KEY=imes-admin-2026

# Chave mestra do Administrador Geral / Dono do SaaS (Header X-Super-Admin-Key)
SUPER_ADMIN_KEY=master-protocolo-2026

# Modo de execução ('production' desativa logs desnecessários e ativa proteções)
ENVIRONMENT=production

# Provedor de armazenamento padrão ('local' para disco particionado A-Z)
STORAGE_PROVIDER=local

# URL base pública da aplicação (para links de notificação WhatsApp e webhooks)
PUBLIC_BASE_URL=https://protocolo.suafaculdade.edu.br
