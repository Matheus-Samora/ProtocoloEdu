# Desenvolvimento local; produção recusa chaves ausentes e contas sem MFA.
PROTOCOL_ENV=development
BIND_HOST=127.0.0.1
FLASK_SECRET_KEY=
COOKIE_SECURE=false
ALLOWED_HOSTS=127.0.0.1,localhost
TRUSTED_PROXY_IPS=
ADMIN_ACCOUNTS_FILE=private/admin-accounts.json
SECURITY_STATE_DIR=private/security-state
# Base64 de 32 bytes aleatórios; guardar em cofre de segredos.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=v1
DATA_ENCRYPTION_KEYS_JSON=
# Chave independente da chave de dados.
BACKUP_ENCRYPTION_KEY=
# Serviços externos desativados em produção até análise e configuração.
ENABLE_EXTERNAL_PROCESSING=false
ENABLE_EXTERNAL_STORAGE=false
OUTBOUND_ALLOWED_HOSTS=
GEMINI_API_KEY=
SUPER_ADMIN_KEY=
PROTOCOL_DEMO_MODE=false
ICP_BRASIL_TRUST_ROOTS_FILE=
